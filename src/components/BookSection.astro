---
import { site } from '../data/site';
interface Props { lang?: 'vi' | 'en' | 'zh' }
const { lang = 'vi' } = Astro.props;
const en = lang === 'en';
const zh = lang === 'zh';
---
<section class="book" id="dat-ban">
  <img src="/images/ban-tiec-ngam-pho.webp" alt="" loading="lazy">
  <div class="wrap">
    <div class="reveal">
      <span class="script">{zh ? '预留看日落的座位' : en ? 'Save your sunset seat' : 'Giữ chỗ ngắm hoàng hôn'}</span>
      <h2>{zh ? '订位' : en ? 'Book a table' : 'Đặt bàn'}</h2>
      <p>{zh ? '请来电或发消息，告知人数、到店时间和订位人姓名。周末靠栏杆的景观座位很快订满，建议提前预订。' : en ? 'Call or message us with your party size, arrival time and name. Railing tables with the best view go fast on weekends, so book early.' : 'Gọi hoặc nhắn tin cho quán, báo số người, giờ đến và tên người đặt. Bàn sát lan can view đẹp nhanh hết vào cuối tuần, nên đặt sớm.'}</p>
      {site.address && <p>📍 {site.mapsUrl ? <a href={site.mapsUrl} target="_blank" rel="noopener">{site.address}</a> : site.address}</p>}
      {site.hours && <p>🕔 {zh ? '每日营业 15:00 – 22:00（最后点餐 21:30）' : en ? 'Open daily 15:00 – 22:00 (last order 21:30)' : site.hours}</p>}
      <a class="phone" href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
    </div>
    <div class="ways reveal">
      <a class="way" href={`tel:${site.phone}`}>
        <span class="ic" style="background:var(--rust)"><svg><use href="#i-phone"/></svg></span>
        <span><b>{zh ? '电话' : en ? 'Call' : 'Gọi điện'}</b><span>{site.phoneDisplay}</span></span>
        <svg class="go" width="20" height="20"><use href="#i-arrow"/></svg>
      </a>
      <a class="way" href={site.zalo} target="_blank" rel="noopener">
        <span class="ic" style="background:var(--zalo)"><svg><use href="#i-zalo"/></svg></span>
        <span><b>{zh ? 'Zalo 消息' : en ? 'Zalo message' : 'Nhắn Zalo'}</b><span>Zalo {site.phoneDisplay}</span></span>
        <svg class="go" width="20" height="20"><use href="#i-arrow"/></svg>
      </a>
      <a class="way" href={site.messenger} target="_blank" rel="noopener">
        <span class="ic" style="background:linear-gradient(135deg,#0a7cff,#a334fa 60%,#ff5c87)"><svg><use href="#i-mess"/></svg></span>
        <span><b>{zh ? 'Messenger' : en ? 'Messenger' : 'Nhắn Messenger'}</b><span>{zh ? 'Trạm Nắng Facebook 主页' : en ? 'Trạm Nắng Facebook page' : 'Fanpage Trạm Nắng Đà Lạt'}</span></span>
        <svg class="go" width="20" height="20"><use href="#i-arrow"/></svg>
      </a>
      <a class="way" href={site.mapsUrl} target="_blank" rel="noopener">
        <span class="ic" style="background:#1e8e3e"><svg><use href="#i-pin"/></svg></span>
        <span><b>{zh ? '导航路线' : en ? 'Directions' : 'Chỉ đường'}</b><span>{site.address}</span></span>
        <svg class="go" width="20" height="20"><use href="#i-arrow"/></svg>
      </a>
    </div>
  </div>
  {site.mapsEmbed && (
    <div class="wrap map reveal" id="ban-do">
      <iframe src={site.mapsEmbed} title={`Bản đồ đường đến ${site.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  )}
</section>
